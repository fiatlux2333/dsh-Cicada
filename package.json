{
  "name": "cicada-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "typecheck": "pnpm generate && tsc -p packages/dsh-cicada/tsconfig.host.json --noEmit && tsc -p packages/dsh-cicada/tsconfig.client.json --noEmit",
    "build": "pnpm generate && node scripts/build.mjs",
    "test": "pnpm generate && vitest run",
    "test:ui": "playwright test",
    "check:package": "node scripts/check-package.mjs",
    "format": "prettier --write packages/dsh-cicada/src scripts tests dev *.ts *.json",
    "pack:plugin": "pnpm build && pnpm --dir packages/dsh-cicada pack --pack-destination ../../dist",
    "dev": "vite --host 127.0.0.1 --port 4178",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-generator": "0.2.1-rc.5",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.3",
    "vite": "^7.2.0",
    "vitest": "^3.2.0"
  }
}
